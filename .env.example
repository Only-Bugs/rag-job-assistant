# Runtime configuration overrides
# Copy to .env and adjust as needed
OLLAMA_HOST=http://localhost:11434
LOG_LEVEL=INFO

# Hugging Face tokenizers: avoid fork warnings / duplicate loads in threaded UIs
TOKENIZERS_PARALLELISM=false

# Override LLM parallel worker count regardless of RAM heuristic (Ollama shares model weights).
LLM_PARALLEL_WORKERS_OVERRIDE=4

# Backward-compatible alias for the same override:
# RAG_LLM_PARALLEL_WORKERS=4

# ── Auth (Google OAuth) ────────────────────────────────────────────────────
# Enables "Sign in with Google" on the login page.
# Leave blank to run in dev mode (no login required, user=dev_user).
#
# Setup:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (type: Web application)
#   3. Add http://localhost:8000/auth/callback as an Authorized redirect URI
#   4. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# Stable secret for signing JWT session tokens — generate once, keep in .env
# Generate: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
