# Runtime configuration overrides
# Copy to .env and adjust as needed
OLLAMA_HOST=http://localhost:11434
LOG_LEVEL=INFO

# Hugging Face tokenizers: avoid fork warnings / duplicate loads in threaded UIs
TOKENIZERS_PARALLELISM=false

# Override LLM parallel worker count regardless of RAM heuristic (Ollama shares model weights).
LLM_PARALLEL_WORKERS_OVERRIDE=4

# Backward-compatible alias for the same override:
# RAG_LLM_PARALLEL_WORKERS=4
